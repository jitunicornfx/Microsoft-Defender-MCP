# Microsoft Entra ID app registration (client-credentials flow) with Defender API application permissions.
DEFENDER_TENANT_ID=00000000-0000-0000-0000-000000000000
DEFENDER_CLIENT_ID=00000000-0000-0000-0000-000000000000
DEFENDER_CLIENT_SECRET=

# --- OR, for several named tenants (do not combine with the three variables above) ---
#DEFENDER_TENANTS=contoso,fabrikam-lab
#DEFENDER_CONTOSO_TENANT_ID=
#DEFENDER_CONTOSO_CLIENT_ID=
#DEFENDER_CONTOSO_CLIENT_SECRET=
#DEFENDER_CONTOSO_ACCESS_LEVEL=read-only     # optional: narrows DEFENDER_ACCESS_LEVEL for this tenant
#DEFENDER_FABRIKAM_LAB_TENANT_ID=
#DEFENDER_FABRIKAM_LAB_CLIENT_ID=
#DEFENDER_FABRIKAM_LAB_CLIENT_SECRET=
#DEFENDER_FABRIKAM_LAB_REGION=eu             # optional: _CLOUD, _REGION
# Tenant used when a call names none; without it the 'tenant' argument is required.
#DEFENDER_DEFAULT_TENANT=

# commercial | gcc | gcc-high | dod
DEFENDER_CLOUD=commercial
# Optional regional endpoint (commercial only): us | eu | uk | au | swa | ina | aea -> https://<code>.api.security.microsoft.com
# Unset uses the global https://api.security.microsoft.com
#DEFENDER_REGION=

# read-only (default) | write | destructive
DEFENDER_ACCESS_LEVEL=read-only
# elicit (default: a human approves every state-changing call) | none (unattended; not recommended)
DEFENDER_CONFIRMATION=elicit
# Advanced hunting always runs on Microsoft Graph (runHuntingQuery); grant the app ThreatHunting.Read.All on Graph.

#DEFENDER_MAX_ACTIONS_PER_HOUR=20
#DEFENDER_MAX_CONCURRENT_REQUESTS=4
#DEFENDER_TIMEOUT_MS=60000
#DEFENDER_MAX_RESPONSE_BYTES=16777216
#DEFENDER_MAX_RESULT_CHARS=200000
# Comma-separated globs of tool names to expose, e.g. defender_get_*,defender_list_*
#DEFENDER_TOOLS=

# --http mode only
#DEFENDER_MCP_AUTH_TOKEN=   # generate with: openssl rand -hex 32
#DEFENDER_HTTP_ALLOWED_ORIGINS=
